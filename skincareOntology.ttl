sc:IngredientInteractionGuide rdf:type owl:NamedIndividual, sc:IngredientGuide ;
    rdfs:label "Panduan Interaksi Ingredient" ;
    sc:difficultyLevel "intermediate" ;
    sc:educationCategory "interactions" ;
    sc:targetAudience "intermediate_users" ;
    sc:explanation "Panduan lengkap kombinasi ingredient yang aman vs berbahaya, dengan tips praktis untuk pemula hingga intermediate." .

sc:SafeCombinationsGuide rdf:type owl:NamedIndividual, sc:IngredientGuide ;
    rdfs:label "Kombinasi Aman untuk Pemula" ;
    sc:difficultyLevel "beginner" ;
    sc:educationCategory "safe_combinations" ;
    sc:targetAudience "skincare_beginners" ;
    sc:explanation "Daftar kombinasi ingredient yang 100% aman untuk skincare pemula, dengan penjelasan sederhana kenapa mereka cocok." .

sc:DangerousCombinationsGuide rdf:type owl:NamedIndividual, sc:IngredientGuide ;
    rdfs:label "Kombinasi yang HARUS Dihindari" ;
    sc:difficultyLevel "beginner" ;
    sc:educationCategory "dangerous_combinations" ;
    sc:targetAudience "all_users" ;
    sc:explanation "Warning guide tentang kombinasi ingredient yang berbahaya, dengan penjelasan mudah dan alternatif solusi." .